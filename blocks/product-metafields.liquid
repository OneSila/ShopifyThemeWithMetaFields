{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  assign selected_variant = product.selected_or_first_available_variant
  
  # Get onesila meta-fields from product
  assign onesila_metafields = product.metafields.onesila
  
  # Get onesila meta-fields from variant (if any)
  assign variant_onesila_metafields = selected_variant.metafields.onesila
-%}

{%- if onesila_metafields or variant_onesila_metafields -%}
  <div
    class="product-metafields spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
    data-variant-metafields="{{ selected_variant.id }}"
  >
    {% if block_settings.heading != blank %}
      <h3 class="product-metafields__heading {{ block_settings.heading_size }}">
        {{ block_settings.heading | escape }}
      </h3>
    {% endif %}
    
    {% if block_settings.description != blank %}
      <p class="product-metafields__description">
        {{ block_settings.description | escape }}
      </p>
    {% endif %}
    
    <dl class="product-metafields__list">
      {%- comment -%} Display product meta-fields {%- endcomment -%}
      {%- if onesila_metafields -%}
        {%- for metafield_pair in onesila_metafields -%}
          {%- assign metafield_key = metafield_pair[0] -%}
          {%- assign metafield_value = metafield_pair[1] -%}
          
          {%- unless metafield_value == blank or metafield_value == null or metafield_value == '' -%}
            <div class="product-metafields__item">
              <dt class="product-metafields__label">
                {{ metafield_key | replace: '_', ' ' | capitalize }}:
              </dt>
              <dd class="product-metafields__value">
                {{ metafield_value }}
              </dd>
            </div>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </dl>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-metafields {
    display: block;
    width: 100%;
  }
  
  .product-metafields__heading {
    margin: 0 0 var(--padding-md) 0;
    font-weight: var(--font-weight-bold);
    color: var(--color-foreground);
  }
  
  .product-metafields__description {
    margin: 0 0 var(--padding-lg) 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: 0.95em;
    line-height: 1.5;
  }
  
  .product-metafields__list {
    display: flex;
    flex-direction: column;
    gap: var(--padding-sm);
  }
  
  .product-metafields__item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--padding-sm) 0;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }
  
  .product-metafields__item:last-child {
    border-bottom: none;
  }
  
  .product-metafields__label {
    font-weight: var(--font-weight-medium);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    margin: 0;
    flex: 0 0 40%;
    padding-right: var(--padding-sm);
  }
  
  .product-metafields__value {
    margin: 0;
    word-break: break-word;
    font-weight: var(--font-weight-normal);
    color: var(--color-foreground);
    flex: 1;
  }
  
  @media screen and (max-width: 749px) {
    .product-metafields__item {
      flex-direction: column;
      gap: var(--padding-2xs);
    }
    
    .product-metafields__label {
      flex: none;
      padding-right: 0;
    }
    
    .product-metafields__value {
      flex: none;
    }
  }
{% endstylesheet %}

<script
  src="{{ 'product-metafields.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% schema %}
{
  "name": "Product Meta-fields",
  "tag": "product-metafields-component",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Specifications"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Optional description text to display above the meta-fields"
    }
  ],
  "presets": [
    {
      "name": "Product Meta-fields",
      "category": "Product"
    }
  ]
}
{% endschema %}
